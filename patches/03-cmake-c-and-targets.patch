+
+# ── MCP 服务器 ────────────────────────────────────────────────────────────
+# 让 AI agent 通过 stdio JSON-RPC 驱动 SpektraLab。只链接 spektralab_core
+# （纯算法，无 Vulkan），所以启动不需要 GPU；渲染类操作调度同目录的
+# spk_raw_render.exe。
+add_executable(spektralab-mcp src/spektralab_mcp.cpp)
+target_compile_features(spektralab-mcp PRIVATE cxx_std_20)
+target_link_libraries(spektralab-mcp PRIVATE spektralab_core)
+set_target_properties(spektralab-mcp PROPERTIES
+    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/app")
 
 # The one resource directory is explicitly adjacent to the executable. No
 # lookup through another checkout and no Python in the application.
